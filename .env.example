# Copy this file to .env (gitignored) and fill in real values.
# Read by docker-compose.yml for the Airflow stack and the ingestion container.
# Whenever you change a value here that Terraform also uses (project_id, bucket_name,
# bronze_gcs_prefix, bigquery_dataset_id), re-run ./infrastructure/terraform/tf.sh plan/apply —
# editing this file alone doesn't touch live infrastructure.

FLIGHT_SEARCH_GCS_BUCKET=your-bucket-name
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Used by docker-compose/DAG and by Terraform via tf.sh (bucket lifecycle rule).
BRONZE_GCS_PREFIX=bronze
SILVER_GCS_PREFIX=silver

# Single source of truth for the BigQuery dataset — read by dbt (profiles.yml/_sources.yml),
# docker-compose's transform service, and Terraform (via infrastructure/terraform/tf.sh).
BIGQUERY_DATASET=your-bigquery-dataset
