.aider*
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
*.pyc

# Cache files
cache/
.ryanair_cookies.json

# Airflow logs (docker-compose local runs), dbt logs
logs/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars

# Docker Compose env vars (FLIGHT_SEARCH_GCS_BUCKET, GOOGLE_CLOUD_PROJECT)
.env

# dbt (pipeline/transform/) build artifacts and machine-specific anonymous-usage id
pipeline/transform/target/
pipeline/transform/dbt_packages/
pipeline/transform/.user.yml
# Generated by dbt_local_test.sh from src/eu_airports.json — regenerated fresh on every run, left on disk after
pipeline/transform/seeds/

# Ignored airports, not required
src/ignored_airports.json
# Ambiguous airports (reviewed and merged manually into eu_airports.json)
src/ambiguous_airports.json
# Unknown airports (reviewed and merged manually into eu_airports.json or ignored_airports.json)
src/unknown_airports.json